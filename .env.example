DATABASE_URL="postgresql://user:password@localhost:5432/store"
DIRECT_URL="postgresql://user:password@localhost:5432/store"

# At least 32 random characters. Rotate only with a plan to reissue guest cart tokens.
CART_SESSION_SECRET="replace-with-at-least-32-random-characters"
CORS_ORIGINS="https://store.example.com,http://localhost:3000"

# For local fake payment testing only: NODE_ENV=development and PAYMENT_MODE=mock.
# Leave PAYMENT_MODE=wayforpay for real gateway payments.
PAYMENT_MODE="wayforpay"

WAYFORPAY_MERCHANT_ACCOUNT="merchant-account-from-wayforpay"
WAYFORPAY_SECRET_KEY="merchant-secret-from-wayforpay"
WAYFORPAY_DOMAIN="store.example.com"
WAYFORPAY_SERVICE_URL="https://api.example.com/checkout/wayforpay/webhook"
WAYFORPAY_RETURN_URL="https://store.example.com/payment-result"

# JSON map of ISO 3166-1 alpha-2 country codes to flat shipping prices in UAH kopiykas.
# Add only countries where the merchant has confirmed shipping, taxes and customs policy.
CHECKOUT_SHIPPING_RATES_UAH_JSON='{"DE":250000,"US":600000}'

# Mock-only country rates in each currency's minor units (cents for USD/EUR).
MOCK_SHIPPING_RATES_MINOR_JSON='{"USD":{"US":6000,"DE":9000},"EUR":{"DE":8000,"US":10000},"UAH":{"DE":250000,"US":600000}}'
