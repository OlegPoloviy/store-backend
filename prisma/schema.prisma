// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum user_role {
  ADMIN
  USER
}

model Product {
  id                    String          @id @default(uuid())
  title                 String
  description           String?         @db.Text 
  price                 Decimal         @db.Decimal(10, 2)
  currency              String          @db.VarChar(10)

  primaryMaterial       String?         
  secondaryMaterials    String[]        
  woodTreatment         String?         
  finish                String?         
  originOfMaterial      String?       
  handmade              Boolean         @default(true) 
  craftsmanshipDetails  String[]       

  width                 Decimal?        @db.Decimal(10, 2)
  depth                 Decimal?        @db.Decimal(10, 2)
  height                Decimal?        @db.Decimal(10, 2)
  unitOfMeasure         String?         @db.VarChar(10) 
  weight                Decimal?        @db.Decimal(10, 2)
  weightUnit            String?         @db.VarChar(10) 
  seatingCapacity       Int?
  storageCapacity       String?         

  style                 String?       
  color                 String?         
  texture               String?        
  designInspiration     String?
  pattern               String?

  features              String[]        
  assemblyRequired      Boolean?
  careInstructions      String?         @db.Text
  warranty              String?

  uniqueIdentifier      String?         @unique 
  designer              String?
  creationDate          DateTime?      
  story                 String?         @db.Text

  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  // Relations
  category              Category        @relation(fields: [categoryId], references: [id])
  categoryId            String
  images                ProductImage[]
  favorites             Favorite[]
  cartItems             CartItem[]
  orderItems            OrderItem[]

  collectionItems CollectionItem[]
}

model Category {
  id       String     @id @default(uuid())
  name     String     @unique
  categoryImage String?
  products Product[]
}

model ProductImage {
  id        String   @id @default(uuid())
  url       String
  altText   String?
  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  product   Product  @relation(fields: [productId], references: [id])
  productId String
}


model User {
  id    String  @id @default(uuid())
  firstName String
  lastName  String
  email    String  @unique
  phone  String
  password String
  role    user_role @default(USER)

  //Location data
  address  String
  city    String
  postalCode Int
  country  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  favorites Favorite[]
  carts     Cart[]
  orders    Order[]
  collections Collection[]
  supportTelegramAdmin SupportTelegramAdmin?
}

model Cart {
  id           String      @id @default(uuid())
  userId       String?     
  anonymousId  String?     
  status       CartStatus  @default(ACTIVE)
  items        CartItem[]
  orders       Order[]
  user         User?       @relation(fields: [userId], references: [id])

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId])
  @@index([anonymousId])
}

model CartItem {
  id            String   @id @default(uuid())
  cartId        String
  productId     String
  quantity      Int      @default(1)
  priceSnapshot Decimal  @db.Decimal(10,2)  // збережена ціна на момент додавання
  currencySnapshot String @db.VarChar(3)

  cart          Cart     @relation(fields: [cartId], references: [id])
  product       Product  @relation(fields: [productId], references: [id])

  createdAt     DateTime @default(now())

  @@index([cartId])
  @@index([productId])
  @@unique([cartId, productId]) // щоб уникнути дублювання товарів
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  productId  String

  user       User     @relation(fields: [userId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])

  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([productId])
  @@unique([userId, productId]) // один товар — один раз у favorites
}

model Collection {
  id        String   @id @default(uuid())
  userId    String
  name      String
  

  isPrivate Boolean  @default(false) 
  
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  collectionItems CollectionItem[]
}

model CollectionItem {
  id           String   @id @default(uuid())
  collectionId String
  productId    String
  addedAt      DateTime @default(now())

  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)


  @@unique([collectionId, productId])
}

enum CartStatus {
  ACTIVE
  CHECKED_OUT
  EXPIRED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentAttemptStatus {
  CREATED
  APPROVED
  DECLINED
  REFUNDED
}

model Order {
  id                 String      @id @default(uuid())
  userId             String?
  anonymousIdHash    String?
  cartId             String
  idempotencyKeyHash String      @unique
  status             OrderStatus @default(PENDING)
  currency           String      @db.VarChar(3)
  subtotalMinor      Int
  shippingMinor      Int
  totalMinor         Int
  shippingCountry    String      @db.VarChar(2)
  shippingAddress    String
  shippingCity       String
  shippingRegion     String?
  shippingPostalCode String
  customerEmail      String
  customerFirstName  String
  customerLastName   String
  customerPhone      String?
  paidAt             DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  user               User?       @relation(fields: [userId], references: [id])
  cart               Cart        @relation(fields: [cartId], references: [id])
  items              OrderItem[]
  attempts           PaymentAttempt[]

  @@index([userId])
  @@index([anonymousIdHash])
  @@index([cartId])
}

model OrderItem {
  id             String  @id @default(uuid())
  orderId        String
  productId      String?
  productTitle   String
  quantity       Int
  unitPriceMinor Int
  totalMinor     Int
  currency       String  @db.VarChar(3)

  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model PaymentAttempt {
  id                String               @id @default(uuid())
  orderId           String
  reference         String               @unique
  status            PaymentAttemptStatus @default(CREATED)
  amountMinor       Int
  currency          String               @db.VarChar(3)
  gatewayStatus     String?
  gatewayReasonCode String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  order             Order                @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

enum SupportConversationStatus {
  OPEN
  CLOSED
}

enum SupportMessageDirection {
  CUSTOMER_TO_ADMIN
  ADMIN_TO_CUSTOMER
}

model SupportTelegramAdmin {
  id                String   @id @default(uuid())
  userId            String   @unique
  telegramChatId    BigInt   @unique
  telegramUsername  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([telegramChatId])
}

model SupportConversation {
  id             String                    @id @default(uuid())
  customerId     String?
  customerName   String?
  customerEmail  String?
  customerPhone  String?
  status         SupportConversationStatus @default(OPEN)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  messages       SupportMessage[]
}

model SupportMessage {
  id             String                  @id @default(uuid())
  conversationId String
  direction      SupportMessageDirection
  body           String                  @db.Text
  senderName     String?
  createdAt      DateTime                @default(now())

  conversation   SupportConversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  deliveries     SupportTelegramDelivery[]

  @@index([conversationId])
}

model SupportTelegramDelivery {
  id                String         @id @default(uuid())
  messageId         String
  telegramChatId    BigInt
  telegramMessageId Int
  createdAt         DateTime       @default(now())

  message           SupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([telegramChatId, telegramMessageId])
  @@index([messageId])
}
